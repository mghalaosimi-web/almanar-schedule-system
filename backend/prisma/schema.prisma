generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubjectType {
  THEORY
  PRACTICAL
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum OverrideType {
  TEMPORARY
  PERMANENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String
  majors Major[]
}

model Major {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
  groups       Group[]

  @@index([departmentId])
}

model Level {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]
  groups   Group[]
}

model Group {
  id               Int               @id @default(autoincrement())
  name             String
  majorId          Int?
  major            Major?            @relation(fields: [majorId], references: [id])
  levelId          Int?
  level            Level?            @relation(fields: [levelId], references: [id])
  students         Student[]
  schedules        Schedule[]
  notificationLogs NotificationLog[]
  examSchedules    ExamSchedule[]
  resources        GroupResource[]
  exchangePosts    ExchangePost[]
  academicGoals    AcademicGoal[]

  @@index([majorId])
  @@index([levelId])
}

model Student {
  id                Int                     @id @default(autoincrement())
  name              String
  email             String                  @unique
  idNumber          String                  @unique
  idPhotoUrl        String?
  phone             String                  @unique
  isEmailVerified   Boolean                 @default(true)
  isPhoneVerified   Boolean                 @default(false)
  isRepresentative  Boolean                 @default(false)
  password          String?
  googleId          String?                 @unique
  majorId           Int
  major             Major                   @relation(fields: [majorId], references: [id])
  levelId           Int
  level             Level                   @relation(fields: [levelId], references: [id])
  groupId           Int?
  group             Group?                  @relation(fields: [groupId], references: [id])
  xp                Int                     @default(350)
  streak            Int                     @default(7)
  lastLoginDate     DateTime?
  isFocusing        Boolean                 @default(false)
  pollVotes         PollVote[]
  tasks             StudentTask[]
  notificationLogs  NotificationLog[]
  verificationCodes VerificationCode[]
  pushSubscriptions PushSubscription[]
  attendanceRecords AttendanceRecord[]
  attendances       Attendance[]
  seatAllocations   SeatAllocation[]
  exchangePosts     ExchangePost[]
  exchangeComments  ExchangeComment[]
  feedbacks         Feedback[]
  goalCompletions   StudentGoalCompletion[]
  createdAt         DateTime                @default(now())

  @@index([majorId])
  @@index([levelId])
  @@index([groupId])
}

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  type          SubjectType
  schedules     Schedule[]
  examSchedules ExamSchedule[]
  academicGoals AcademicGoal[]
}

model Room {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  capacity           Int
  schedules          Schedule[]
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  examSchedules      ExamSchedule[]
}

model Lecturer {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  phone              String?
  schedules          Schedule[]
  rescheduleRequests RescheduleRequest[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime            @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RescheduleRequest {
  id           Int           @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  lecturerId   Int
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id])
  requestType  String // 'CANCEL' or 'RESCHEDULE'
  newDayOfWeek DayOfWeek?
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?         @relation(fields: [newRoomId], references: [id])
  reason       String?
  status       RequestStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime      @default(now())

  @@index([scheduleId])
  @@index([lecturerId])
}

model Schedule {
  id                 Int                 @id @default(autoincrement())
  subjectId          Int
  subject            Subject             @relation(fields: [subjectId], references: [id])
  roomId             Int
  room               Room                @relation(fields: [roomId], references: [id])
  lecturerName       String
  lecturerId         Int?
  lecturer           Lecturer?           @relation(fields: [lecturerId], references: [id])
  groupId            Int
  group              Group               @relation(fields: [groupId], references: [id])
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  attendanceRecords  AttendanceRecord[]
  attendances        Attendance[]
  academicGoals      AcademicGoal[]

  @@index([groupId])
  @@index([lecturerId])
  @@index([dayOfWeek])
}

model ScheduleOverride {
  id           Int          @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?        @relation(fields: [newRoomId], references: [id])
  date         DateTime
  overrideType OverrideType

  @@index([scheduleId])
  @@index([date])
}

model NotificationLog {
  id          Int                @id @default(autoincrement())
  studentId   Int?
  student     Student?           @relation(fields: [studentId], references: [id])
  groupId     Int?
  group       Group?             @relation(fields: [groupId], references: [id])
  title       String?
  message     String
  sentTime    DateTime           @default(now())
  deliveredAt DateTime?
  readAt      DateTime?
  deviceToken String?
  platform    String?
  status      NotificationStatus
  broadcastId String?

  @@index([studentId])
  @@index([groupId])
  @@index([sentTime])
  @@index([status])
  @@index([broadcastId])
}

enum AdminRole {
  ADMIN
}

model Admin {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  role              AdminRole          @default(ADMIN)
  pushSubscriptions PushSubscription[]
}

enum VerificationType {
  EMAIL
  PHONE
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String
  type      VerificationType
  expiresAt DateTime

  @@index([studentId])
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  studentId  Int?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  lecturerId Int?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())

  @@index([studentId])
  @@index([adminId])
  @@index([lecturerId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model AttendanceRecord {
  id         Int              @id @default(autoincrement())
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId Int
  schedule   Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  scannedAt  DateTime         @default(now())

  @@unique([studentId, scheduleId, date])
  @@index([scheduleId, date])
}

model ExamSchedule {
  id              Int              @id @default(autoincrement())
  subjectId       Int
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomId          Int
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  groupId         Int
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String
  endTime         String
  seatAllocations SeatAllocation[]

  @@index([groupId])
  @@index([date])
}

model SeatAllocation {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  seatNumber     String

  @@unique([studentId, examScheduleId])
  @@unique([examScheduleId, seatNumber])
}

model Attendance {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  status       String
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId   Int
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recordedById Int

  @@index([studentId])
  @@index([scheduleId, date])
}

model GroupResource {
  id         String   @id @default(uuid())
  title      String
  url        String
  groupId    Int
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  postedById Int
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
}

enum PostCategory {
  QUESTION
  RESOURCE
  HELP
  GENERAL
  POLL
}

model ExchangePost {
  id          String            @id @default(uuid())
  title       String
  content     String
  category    PostCategory      @default(GENERAL)
  groupId     Int
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comments    ExchangeComment[]
  isAnonymous Boolean           @default(false)
  poll        Poll?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@index([studentId])
}

model ExchangeComment {
  id          String       @id @default(uuid())
  postId      String
  post        ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     String
  isAnonymous Boolean      @default(false)
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([postId])
  @@index([studentId])
}

model Poll {
  id        String       @id @default(uuid())
  question  String
  options   String[]
  postId    String       @unique
  post      ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     PollVote[]
  createdAt DateTime     @default(now())
}

model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  optionIdx Int
  createdAt DateTime @default(now())

  @@unique([pollId, studentId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message   String
  category  String?
  rating    Int?
  createdAt DateTime @default(now())

  @@index([studentId])
}

model StudentTask {
  id        String    @id @default(uuid())
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  completed Boolean   @default(false)
  category  String    @default("PERSONAL")
  createdAt DateTime  @default(now())

  @@index([studentId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userEmail  String
  ipAddress  String
  timestamp  DateTime @default(now())
  details    Json

  @@index([timestamp])
  @@index([userEmail])
}

model SessionLog {
  id             Int       @id @default(autoincrement())
  userEmail      String
  role           String
  loginTime      DateTime  @default(now())
  logoutTime     DateTime?
  devicePlatform String?
  ipAddress      String
  status         String
  isRevoked      Boolean   @default(false)
  userAgent      String?
  deviceOs       String?
  browser        String?
  appVersion     String?
  country        String?

  @@index([userEmail])
  @@index([loginTime])
}

model InsightLog {
  id          Int      @id @default(autoincrement())
  generatedAt DateTime @default(now())
  category    String
  severity    String
  title       String
  body        String   @db.Text
  data        Json?

  @@index([generatedAt])
}

model BlockedIP {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String?
  blockedAt DateTime @default(now())

  @@index([ip])
}

enum GoalType {
  ASSIGNMENT
  PROJECT
  EXAM
  ACHIEVEMENT
}

model AcademicGoal {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  type        GoalType  @default(ASSIGNMENT)
  dueDate     DateTime?
  weekNumber  Int?

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  groupId Int?
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  scheduleId Int?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  completions StudentGoalCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([groupId])
  @@index([scheduleId])
}

model StudentGoalCompletion {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicGoalId Int
  academicGoal   AcademicGoal @relation(fields: [academicGoalId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())
  status         String       @default("COMPLETED")

  @@unique([studentId, academicGoalId])
  @@index([studentId])
  @@index([academicGoalId])
}
