generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum SubjectType {
  THEORY
  PRACTICAL
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum OverrideType {
  TEMPORARY
  PERMANENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  UNI_ADMIN
  COLLEGE_ADMIN
}

enum VerificationType {
  EMAIL
  PHONE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum PostCategory {
  QUESTION
  RESOURCE
  HELP
  GENERAL
  POLL
}

enum GoalType {
  ASSIGNMENT
  PROJECT
  EXAM
  ACHIEVEMENT
}

// ──────────────────────────────────────────────
// MULTI-TENANT HIERARCHY
// ──────────────────────────────────────────────

model Governorate {
  id           String       @id @default(uuid())
  name         String       @unique
  universities University[]
}

model University {
  id             Int          @id @default(autoincrement())
  name           String
  slug           String       @unique
  logoUrl        String?
  themeColor     String?
  governorateId  String?
  governorate    Governorate? @relation(fields: [governorateId], references: [id], onDelete: SetNull)
  colleges       College[]
  admins         Admin[]
  tenantConfigs  TenantConfig[]

  @@index([governorateId])
}

model College {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  location      String?
  universityId  Int
  university    University     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments   Department[]
  groups        Group[]
  students      Student[]
  lecturers     Lecturer[]
  subjects      Subject[]
  rooms         Room[]
  schedules     Schedule[]
  examSchedules ExamSchedule[]
  admins        Admin[]
  tenantConfig  TenantConfig?

  @@index([universityId])
}

model TenantConfig {
  id              Int        @id @default(autoincrement())
  universityId    Int?       @unique
  university      University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
  collegeId       Int?       @unique
  college         College?   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  themeColor      String?
  logoUrl         String?
  customDomain    String?
  enabledFeatures Json       @default("{}")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ──────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ──────────────────────────────────────────────

model Department {
  id        Int     @id @default(autoincrement())
  name      String
  collegeId Int
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  majors    Major[]

  @@index([collegeId])
}

model Major {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
  groups       Group[]

  @@index([departmentId])
}

model Level {
  id       Int       @id @default(autoincrement())
  name     String
  students Student[]
  groups   Group[]
}

model Group {
  id               Int               @id @default(autoincrement())
  name             String
  majorId          Int?
  major            Major?            @relation(fields: [majorId], references: [id])
  levelId          Int?
  level            Level?            @relation(fields: [levelId], references: [id])
  collegeId        Int
  college          College           @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  students         Student[]
  schedules        Schedule[]
  notificationLogs NotificationLog[]
  examSchedules    ExamSchedule[]
  resources        GroupResource[]
  exchangePosts    ExchangePost[]
  academicGoals    AcademicGoal[]

  @@index([majorId])
  @@index([levelId])
  @@index([collegeId])
}

// ──────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────

/// Canonical authentication identity. Existing profile tables remain intact and
/// are linked additively during backfill.
model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  emailNormalized    String               @unique
  displayName        String
  isActive           Boolean              @default(true)
  student            Student?
  lecturer           Lecturer?
  admin              Admin?
  passwordCredential PasswordCredential?
  authIdentities     AuthIdentity[]
  sessions           UserSession[]
  roles              UserRole[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model PasswordCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthIdentity {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  metadata   Json      @default("{}")

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId    String
  roleId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Portal {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  route     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                Int                     @id @default(autoincrement())
  name              String
  email             String                  @unique
  idNumber          String                  @unique
  idPhotoUrl        String?
  phone             String                  @unique
  isEmailVerified   Boolean                 @default(true)
  isPhoneVerified   Boolean                 @default(false)
  isRepresentative  Boolean                 @default(false)
  password          String?
  googleId          String?                 @unique
  userId            String?                 @unique
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  collegeId         Int
  college           College                 @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  majorId           Int
  major             Major                   @relation(fields: [majorId], references: [id])
  levelId           Int
  level             Level                   @relation(fields: [levelId], references: [id])
  groupId           Int?
  group             Group?                  @relation(fields: [groupId], references: [id])
  xp                Int                     @default(350)
  streak            Int                     @default(7)
  lastLoginDate     DateTime?
  isFocusing        Boolean                 @default(false)
  pollVotes         PollVote[]
  tasks             StudentTask[]
  notificationLogs  NotificationLog[]
  verificationCodes VerificationCode[]
  pushSubscriptions PushSubscription[]
  attendanceRecords AttendanceRecord[]
  attendances       Attendance[]
  seatAllocations   SeatAllocation[]
  exchangePosts     ExchangePost[]
  exchangeComments  ExchangeComment[]
  feedbacks         Feedback[]
  goalCompletions   StudentGoalCompletion[]
  createdAt         DateTime                @default(now())

  @@index([collegeId])
  @@index([majorId])
  @@index([levelId])
  @@index([groupId])
}

model Lecturer {
  id                 Int                 @id @default(autoincrement())
  name               String
  email              String              @unique
  password           String
  userId             String?             @unique
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone              String?
  collegeId          Int
  college            College             @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  schedules          Schedule[]
  rescheduleRequests RescheduleRequest[]
  pushSubscriptions  PushSubscription[]
  createdAt          DateTime            @default(now())

  @@index([collegeId])
}

model Admin {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  password          String
  userId            String?             @unique
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  role              AdminRole          @default(ADMIN)
  collegeId         Int?
  college           College?           @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  universityId      Int?
  university        University?        @relation(fields: [universityId], references: [id], onDelete: SetNull)
  pushSubscriptions PushSubscription[]

  @@index([collegeId])
  @@index([universityId])
}

// ──────────────────────────────────────────────
// SCHEDULE & SUBJECTS
// ──────────────────────────────────────────────

model Subject {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  type          SubjectType
  collegeId     Int
  college       College        @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  schedules     Schedule[]
  examSchedules ExamSchedule[]
  academicGoals AcademicGoal[]

  @@index([collegeId])
}

model Room {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  capacity           Int
  collegeId          Int
  college            College             @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  schedules          Schedule[]
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  examSchedules      ExamSchedule[]

  @@index([collegeId])
}

model Schedule {
  id                 Int                 @id @default(autoincrement())
  subjectId          Int
  subject            Subject             @relation(fields: [subjectId], references: [id])
  roomId             Int
  room               Room                @relation(fields: [roomId], references: [id])
  lecturerName       String
  lecturerId         Int?
  lecturer           Lecturer?           @relation(fields: [lecturerId], references: [id])
  groupId            Int
  group              Group               @relation(fields: [groupId], references: [id])
  collegeId          Int
  college            College             @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  dayOfWeek          DayOfWeek
  startTime          String
  endTime            String
  overrides          ScheduleOverride[]
  rescheduleRequests RescheduleRequest[]
  attendanceRecords  AttendanceRecord[]
  attendances        Attendance[]
  academicGoals      AcademicGoal[]

  @@index([groupId])
  @@index([collegeId])
  @@index([lecturerId])
  @@index([dayOfWeek])
}

model ScheduleOverride {
  id           Int          @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?        @relation(fields: [newRoomId], references: [id])
  date         DateTime
  overrideType OverrideType

  @@index([scheduleId])
  @@index([date])
}

model RescheduleRequest {
  id           Int           @id @default(autoincrement())
  scheduleId   Int
  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  lecturerId   Int
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id])
  requestType  String
  newDayOfWeek DayOfWeek?
  newStartTime String?
  newEndTime   String?
  newRoomId    Int?
  newRoom      Room?         @relation(fields: [newRoomId], references: [id])
  reason       String?
  status       RequestStatus @default(PENDING)
  adminNotes   String?
  createdAt    DateTime      @default(now())

  @@index([scheduleId])
  @@index([lecturerId])
}

// ──────────────────────────────────────────────
// NOTIFICATIONS & SESSIONS
// ──────────────────────────────────────────────

model NotificationLog {
  id          Int                @id @default(autoincrement())
  studentId   Int?
  student     Student?           @relation(fields: [studentId], references: [id])
  groupId     Int?
  group       Group?             @relation(fields: [groupId], references: [id])
  title       String?
  message     String
  sentTime    DateTime           @default(now())
  deliveredAt DateTime?
  readAt      DateTime?
  deviceToken String?
  platform    String?
  status      NotificationStatus
  broadcastId String?

  @@index([studentId])
  @@index([groupId])
  @@index([sentTime])
  @@index([status])
  @@index([broadcastId])
}

model PushSubscription {
  id         Int       @id @default(autoincrement())
  studentId  Int?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  adminId    Int?
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  lecturerId Int?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())

  @@index([studentId])
  @@index([adminId])
  @@index([lecturerId])
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  code      String
  type      VerificationType
  expiresAt DateTime

  @@index([studentId])
}

model SessionLog {
  id             Int       @id @default(autoincrement())
  userEmail      String
  role           String
  loginTime      DateTime  @default(now())
  logoutTime     DateTime?
  devicePlatform String?
  ipAddress      String
  status         String
  isRevoked      Boolean   @default(false)
  userAgent      String?
  deviceOs       String?
  browser        String?
  appVersion     String?
  country        String?

  @@index([userEmail])
  @@index([loginTime])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userEmail  String
  ipAddress  String
  timestamp  DateTime @default(now())
  details    Json

  @@index([timestamp])
  @@index([userEmail])
}

model InsightLog {
  id          Int      @id @default(autoincrement())
  generatedAt DateTime @default(now())
  category    String
  severity    String
  title       String
  body        String   @db.Text
  data        Json?

  @@index([generatedAt])
}

model BlockedIP {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  reason    String?
  blockedAt DateTime @default(now())

  @@index([ip])
}

// ──────────────────────────────────────────────
// ATTENDANCE
// ──────────────────────────────────────────────

model AttendanceRecord {
  id         Int              @id @default(autoincrement())
  studentId  Int
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId Int
  schedule   Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  scannedAt  DateTime         @default(now())

  @@unique([studentId, scheduleId, date])
  @@index([scheduleId, date])
}

model Attendance {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  status       String
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId   Int
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recordedById Int

  @@index([studentId])
  @@index([scheduleId, date])
}

// ──────────────────────────────────────────────
// EXAMS
// ──────────────────────────────────────────────

model ExamSchedule {
  id              Int              @id @default(autoincrement())
  subjectId       Int
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  roomId          Int
  room            Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  groupId         Int
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  collegeId       Int
  college         College          @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  date            DateTime
  startTime       String
  endTime         String
  seatAllocations SeatAllocation[]

  @@index([groupId])
  @@index([collegeId])
  @@index([date])
}

model SeatAllocation {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examScheduleId Int
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  seatNumber     String

  @@unique([studentId, examScheduleId])
  @@unique([examScheduleId, seatNumber])
}

// ──────────────────────────────────────────────
// EXCHANGE & COMMUNITY
// ──────────────────────────────────────────────

model GroupResource {
  id         String   @id @default(uuid())
  title      String
  url        String
  groupId    Int
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  postedById Int
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
}

model ExchangePost {
  id          String            @id @default(uuid())
  title       String
  content     String
  category    PostCategory      @default(GENERAL)
  groupId     Int
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  comments    ExchangeComment[]
  isAnonymous Boolean           @default(false)
  poll        Poll?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@index([studentId])
}

model ExchangeComment {
  id          String       @id @default(uuid())
  postId      String
  post        ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  studentId   Int
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     String
  isAnonymous Boolean      @default(false)
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([postId])
  @@index([studentId])
}

model Poll {
  id        String       @id @default(uuid())
  question  String
  options   String[]
  postId    String       @unique
  post      ExchangePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes     PollVote[]
  createdAt DateTime     @default(now())
}

model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  optionIdx Int
  createdAt DateTime @default(now())

  @@unique([pollId, studentId])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message   String
  category  String?
  rating    Int?
  createdAt DateTime @default(now())

  @@index([studentId])
}

// ──────────────────────────────────────────────
// TASKS & GOALS
// ──────────────────────────────────────────────

model StudentTask {
  id        String    @id @default(uuid())
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  completed Boolean   @default(false)
  category  String    @default("PERSONAL")
  createdAt DateTime  @default(now())

  @@index([studentId])
}

model AcademicGoal {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  type        GoalType  @default(ASSIGNMENT)
  dueDate     DateTime?
  weekNumber  Int?

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  groupId Int?
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  scheduleId Int?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  completions StudentGoalCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([groupId])
  @@index([scheduleId])
}

model StudentGoalCompletion {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicGoalId Int
  academicGoal   AcademicGoal @relation(fields: [academicGoalId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())
  status         String       @default("COMPLETED")

  @@unique([studentId, academicGoalId])
  @@index([studentId])
  @@index([academicGoalId])
}
